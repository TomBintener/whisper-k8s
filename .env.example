# ==============================================================================
# whisper-k8s Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service Selection & Server Networking
# ------------------------------------------------------------------------------
# Active service to run: "bridge" (FastAPI REST server), "pool_worker" (daemon), or "preload"
SERVICE=bridge

# Server bind host and port (bridge service)
HOST=0.0.0.0
PORT=8080

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. File Storage Paths (Shared Persistent Volume Claim)
# ------------------------------------------------------------------------------
# Base data directory inside containers
DATA_DIR=/data

# Subdirectory for source video and audio files
VIDEOS_DIR=/data/videos

# Subdirectory for generated subtitles (.srt, .vtt) and embedded MP4s
SUBS_DIR=/data/subs

# Shared directory for cached Whisper model weights (prevents repeated downloads)
MODELS_DIR=/data/models

# Queue directory for FileTaskQueue (when QUEUE_BACKEND=file)
QUEUE_DIR=/data/queue

# ------------------------------------------------------------------------------
# 3. Execution Engine & Task Queue
# ------------------------------------------------------------------------------
# Default job execution mode:
#   "pool"       -> Warm worker pool holding models in GPU VRAM (fastest, <10ms queue)
#   "kubernetes" -> Ephemeral Kubernetes batch Job created per task
#   "pod"        -> Direct Kubernetes Pod without Job wrapper
#   "ssh"        -> Proxied execution to an external bare-metal GPU / Apple Silicon host
MODE=pool

# Task queue backend: "file" (zero-dependency on shared PVC) or "redis"
QUEUE_BACKEND=file

# Redis connection URL (used if QUEUE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Speech Recognition & Hardware Defaults
# ------------------------------------------------------------------------------
# Default inference backend: "faster-whisper" (recommended for CUDA), "whisper", or "whisper.cpp"
DEFAULT_BACKEND=faster-whisper

# Execution device: "gpu" (mapped to CUDA) or "cpu"
DEFAULT_DEVICE=gpu

# Default Whisper model name ("tiny", "base", "small", "medium", "large-v3")
DEFAULT_MODEL=base

# Quantization and precision:
#   "int8_float16" (optimal for RTX/T4/A100 with time-slicing), "float16", "int8", "float32"
DEFAULT_COMPUTE_TYPE=int8_float16

# ------------------------------------------------------------------------------
# 5. GPU Fractional Sharing & Time-Slicing Guardrails
# ------------------------------------------------------------------------------
# Maximum GPU VRAM fraction allocated per worker process (0.0 to 1.0)
# Set to 0.25 when sharing 1 physical GPU across 4 worker replicas
DEFAULT_VRAM_FRACTION=0.25

# PyTorch allocator fragmentation guard (prevents out-of-memory spikes)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ------------------------------------------------------------------------------
# 6. VAD Silence Chunking & Parallel Dispatch
# ------------------------------------------------------------------------------
# Enable automated splitting at silence boundaries for long recordings
ENABLE_CHUNKING=false

# Target duration per chunk in seconds (minimum 30 seconds)
CHUNK_DURATION_SEC=600

# Number of parallel worker threads for chunk processing (1 to 16)
PARALLEL_CHUNKS=4

# ------------------------------------------------------------------------------
# 7. Push Webhooks & SSRF Security Protection
# ------------------------------------------------------------------------------
# Webhook HTTP delivery timeout in seconds
WEBHOOK_TIMEOUT=10.0

# Maximum exponential backoff retry attempts for failed webhooks
WEBHOOK_MAX_RETRIES=3

# SSRF Protection: Set to true ONLY in local sandbox testing to allow loopback targets (127.0.0.1)
# ALWAYS keep false in production to block loopbacks and cloud metadata (169.254.169.254)
ALLOW_LOCAL_URLS=false

# ------------------------------------------------------------------------------
# 8. Kubernetes Cluster Settings (For MODE=kubernetes or MODE=pod)
# ------------------------------------------------------------------------------
# Namespace where worker batch Jobs or Pods are created
NAMESPACE=default

# Worker container image pulled by Kubernetes jobs
KUBE_IMAGE=whisper-worker:local

# ------------------------------------------------------------------------------
# 9. Bare-Metal SSH Proxy Settings (For MODE=ssh)
# ------------------------------------------------------------------------------
# SSH_HOST=gpu-server.lan
# SSH_USER=whisper
# SSH_KEY=/root/.ssh/id_rsa
# REMOTE_BASE_DIR=/mnt/nvme/whisper
